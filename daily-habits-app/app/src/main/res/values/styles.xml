<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Glass" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_gradient</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:colorAccent">@color/accent_cyan</item>
        <item name="android:colorPrimary">@color/accent</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
    </style>

    <style name="GlassCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/glass_card</item>
        <item name="android:padding">18dp</item>
        <item name="android:layout_marginBottom">14dp</item>
        <item name="android:elevation">0dp</item>
    </style>

    <style name="GlassButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/glass_chip</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:foreground">?android:attr/selectableItemBackground</item>
    </style>

    <style name="GlassProgress" parent="@android:style/Widget.Material.ProgressBar.Horizontal">
        <item name="android:progressDrawable">@drawable/progress_glass</item>
        <item name="android:minHeight">8dp</item>
        <item name="android:maxHeight">8dp</item>
    </style>
</resources>
